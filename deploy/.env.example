# Copy to deploy/.env and edit. Every variable without a default is required;
# docker compose refuses to start when one is missing.

# Image tag to build/run. Bump for every release; keep the previous value for rollback.
NETHER_EARTH_VERSION=1.1.0

# Commit the images were built from, logged at startup by both services so a
# running container can be identified. `make build` sets it automatically;
# leave it unset for a plain `docker compose build` and it reads "unknown".
# NETHER_EARTH_COMMIT=

# Public URL players open. Its origin is the only one allowed to open /ws.
NETHER_EARTH_PUBLIC_BASE_URL=https://nether-earth.example.com

# Host directory for replay/debug artifacts (survives container restart/redeploy).
# Create it once: sudo install -d -o 10001 -g 10001 /srv/nether-earth/replays
NETHER_EARTH_REPLAY_HOST_DIR=/srv/nether-earth/replays

# Optional
# NETHER_EARTH_HTTP_PORT=80
# NETHER_EARTH_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR (JSON lines on stdout)
# NETHER_EARTH_MAX_MATCHES=200         # matches held in memory at once; beyond -> server_busy
# NETHER_EARTH_FINISHED_MATCH_RETENTION_SECONDS=300   # finished match kept for late reconnects
# NETHER_EARTH_WAITING_MATCH_TIMEOUT_SECONDS=900      # lobby without an opponent is dropped
# NETHER_EARTH_ABANDONED_LOBBY_GRACE_SECONDS=30      # lobby with no socket attached is dropped after this
# NETHER_EARTH_BACKEND_MEM_LIMIT=1g
# NETHER_EARTH_BACKEND_CPUS=1.0

# TLS at Nginx (only with -f docker-compose.tls.yml)
# NETHER_EARTH_HTTPS_PORT=443
# NETHER_EARTH_TLS_CERT_DIR=/srv/nether-earth/tls          # fullchain.pem + privkey.pem, readable by uid 101
# NETHER_EARTH_ACME_WEBROOT=/srv/nether-earth/acme-webroot  # certbot --webroot target
