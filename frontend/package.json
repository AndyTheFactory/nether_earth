{
  "name": "nether-earth-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run map:generate && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "protocol:validate": "node scripts/validate-protocol.mjs",
    "protocol:generate": "node scripts/generate-protocol.mjs",
    "map:generate": "node scripts/generate-map.mjs",
    "test": "vitest run",
    "live:check": "node scripts/live-two-client.mjs"
  },
  "dependencies": {
    "pixi.js": "8.8.1"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "ajv": "8.17.1",
    "js-yaml": "4.1.0",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.7.3",
    "vite": "6.1.0",
    "vitest": "^3.2.4"
  }
}
