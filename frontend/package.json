{
  "name": "nether-earth-frontend",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run map:generate && tsc --noEmit && VITE_APP_VERSION=$npm_package_version vite build",
    "typecheck": "tsc --noEmit",
    "protocol:validate": "node scripts/validate-protocol.mjs",
    "protocol:generate": "node scripts/generate-protocol.mjs",
    "map:generate": "node scripts/generate-map.mjs",
    "rules:generate": "node scripts/generate-rules.mjs",
    "test": "vitest run",
    "live:check": "node scripts/live-two-client.mjs"
  },
  "dependencies": {
    "pixi.js": "8.8.1"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "ajv": "8.20.0",
    "happy-dom": "20.14.5",
    "js-yaml": "4.3.2",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
